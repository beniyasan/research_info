{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["selected"],
  "properties": {
    "selected": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "japanese_title", "japanese_summary"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "japanese_title": {
            "type": "string",
            "minLength": 1
          },
          "japanese_summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
