{
  "reporting": {
    "score_threshold": 3.0,
    "max_articles": 30
  },
  "selection": {
    "mode": "llm",
    "provider": "vertex_gemini",
    "model": "gemini-3.5-flash",
    "candidate_limit": 80,
    "command_env": "AI_RESEARCH_LLM_COMMAND",
    "timeout_seconds": 300,
    "temperature": 0.2,
    "max_output_tokens": 8192,
    "vertex": {
      "project_env": "GOOGLE_CLOUD_PROJECT",
      "location_env": "GOOGLE_CLOUD_LOCATION",
      "default_location": "global"
    }
  },
  "preferences": {
    "min_feedback_count": 20,
    "max_adjustment": 0.7
  },
  "grounding": {
    "enabled": true,
    "model": "gemini-3.5-flash",
    "timeout_seconds": 180,
    "temperature": 0.1,
    "max_output_tokens": 4096,
    "article_verification": {
      "enabled": true,
      "batch_size": 8,
      "timeout_seconds": 180,
      "max_output_tokens": 4096,
      "fail_report_on_error": false
    },
    "source_discovery": {
      "enabled": true,
      "limit": 10,
      "candidate_source_limit": 5,
      "min_confidence": 0.65,
      "validate_feeds": true,
      "timeout_seconds": 180,
      "max_output_tokens": 4096,
      "fail_run_on_error": false,
      "queries": [
        "high signal AI engineering RSS feeds LLM agents RAG evaluations developer tools",
        "official AI model release blogs RSS Anthropic OpenAI Google DeepMind Meta Mistral Microsoft NVIDIA AWS",
        "LLM application engineering newsletters RSS AI agents inference evals",
        "AI research digest RSS arxiv LLM agents multimodal code generation"
      ]
    }
  },
  "limits": {
    "active_keywords": 80,
    "active_sources": 40
  },
  "notifications": {
    "discord": {
      "enabled": true,
      "username": "AI Researcher",
      "top_articles": 5,
      "color": 3447003
    }
  },
  "integrations": {
    "google_drive": {
      "enabled": true,
      "root_folder_name": "AI Researcher",
      "client_secret_env": "GOOGLE_DRIVE_CLIENT_SECRET",
      "token_env": "GOOGLE_DRIVE_TOKEN",
      "scopes": [
        "https://www.googleapis.com/auth/drive.file"
      ],
      "mime_type": "text/markdown",
      "fail_report_on_error": false
    }
  },
